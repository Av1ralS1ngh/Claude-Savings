# Copy this to .env and fill in your values.

# ── YSCompress compression proxy ──────────────────────────────────────────────
YSCOMPRESS_BASE_URL=http://127.0.0.1:8787
YSCOMPRESS_MODE=safe          # safe | aggressive | off
YSCOMPRESS_CCR=true
YSCOMPRESS_TIMEOUT_S=8

# ── Anthropic upstream ─────────────────────────────────────────────────────────
DECOMPUTE_MOCK_ANTHROPIC=true   # set false + add key to use real Claude
# ANTHROPIC_API_KEY=sk-ant-...

# ── Gateway ────────────────────────────────────────────────────────────────────
DECOMPUTE_ENV=local
DECOMPUTE_HOST=127.0.0.1
DECOMPUTE_PORT=8080
DECOMPUTE_API_KEY=dc_dev_local
DECOMPUTE_REQUIRE_AUTH=false

# ── Local coding student (teacher-student) ────────────────────────────────────
# OPTIONAL and OFF by default. The local student answers narrow coding tasks via the explicit
# `decompute ts-run` / `ts-health` / `local-chat` commands only — it never touches /v1/messages.
# Leave these commented to keep it disabled. Start a backend first, e.g.:
#   llama-server -hf <model-gguf> --port 18080
# DECOMPUTE_LOCAL_STUDENT_ENABLED=false              # master switch
# DECOMPUTE_LOCAL_STUDENT_BACKEND=llama_cpp          # llama_cpp | ollama | lmstudio | vllm | openai_compatible
# DECOMPUTE_LOCAL_STUDENT_BASE_URL=http://127.0.0.1:18080/v1
# DECOMPUTE_LOCAL_STUDENT_MODEL=local-student-coder  # model id the backend reports
# DECOMPUTE_LOCAL_STUDENT_API_KEY=                   # usually unset for a local server
# DECOMPUTE_LOCAL_STUDENT_CONTEXT_WINDOW=32000
# DECOMPUTE_LOCAL_STUDENT_MAX_OUTPUT_TOKENS=2048
# DECOMPUTE_LOCAL_STUDENT_CONNECT_TIMEOUT_S=3
# DECOMPUTE_LOCAL_STUDENT_READ_TIMEOUT_S=60
# DECOMPUTE_LOCAL_STUDENT_OVERALL_TIMEOUT_S=120
# DECOMPUTE_LOCAL_STUDENT_HEALTH_TTL_S=15
# DECOMPUTE_LOCAL_STUDENT_MAX_CONCURRENCY=1
# DECOMPUTE_LOCAL_STUDENT_MOCK=false                 # dev/test only — a flagged in-process mock,
#                                                    # NOT a fallback for a down model; rejected in prod
#
# Inline serving on the live /v1/messages path (the one `decompute claude` proxies). OFF by default:
# with this false the student serves only via the explicit `decompute ts-run` command and is
# observe-only on the proxy. When ON, an eligible coding turn is tried by the student first; if the
# verifier accepts it is served locally (no Claude call), otherwise it falls through to the same Claude
# call the request would have made — reusing the request's own auth. REQUIRES a verification signal:
# the judge (recommended on the proxy, since real requests carry no tests) or sandbox test execution.
# DECOMPUTE_LOCAL_STUDENT_SERVE=false
# DECOMPUTE_TS_JUDGE_ENABLED=false                   # independent Claude reviewer; the serve signal when
#                                                    # there are no user-supplied tests
