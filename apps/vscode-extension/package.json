{
  "name": "decompute",
  "displayName": "Decompute \u2014 Claude optimizer",
  "description": "Route Claude Code through the Decompute gateway: compress context, cut tokens, BYOK. Free 100 compressions/day; Pro for unlimited fair-use.",
  "version": "0.1.2",
  "publisher": "decompute",
  "license": "MIT",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Machine Learning",
    "Other"
  ],
  "keywords": [
    "claude",
    "anthropic",
    "claude code",
    "tokens",
    "compression"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Decompute-AI/Claude-Coder"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "decompute.activate",
        "title": "Decompute: Activate Pro License"
      },
      {
        "command": "decompute.upgrade",
        "title": "Decompute: Upgrade to Pro"
      },
      {
        "command": "decompute.status",
        "title": "Decompute: Show Status"
      },
      {
        "command": "decompute.setKey",
        "title": "Decompute: Set Claude (Anthropic) Key"
      },
      {
        "command": "decompute.enableRouting",
        "title": "Decompute: Enable Routing (compress via gateway)"
      },
      {
        "command": "decompute.rewire",
        "title": "Decompute: Re-wire Claude Code Routing"
      },
      {
        "command": "decompute.disableRouting",
        "title": "Decompute: Disable Routing (go direct)"
      },
      {
        "command": "decompute.openDashboard",
        "title": "Decompute: Open Dashboard"
      }
    ],
    "configuration": {
      "title": "Decompute",
      "properties": {
        "decompute.gatewayUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8080",
          "description": "Decompute gateway base URL."
        },
        "decompute.autoWireTerminal": {
          "type": "boolean",
          "default": false,
          "description": "Route the Claude Code CLI in integrated terminals through the gateway (ANTHROPIC_BASE_URL + Decompute headers). OFF by default \u2014 routing requires a funded Anthropic API key (BYOK); enable via 'Decompute: Enable Routing'. The Claude key is never written here."
        },
        "decompute.routeClaudeCodePanel": {
          "type": "boolean",
          "default": false,
          "description": "Route the Claude Code VS Code panel (and CLI) through the gateway via an env block in ~/.claude/settings.json. OFF by default. WARNING: if you use a claude.ai subscription, routing switches billing to an API key and will fail if it has no credits. Reverted automatically when disabled."
        },
        "decompute.pollSeconds": {
          "type": "number",
          "default": 60,
          "description": "How often (seconds) to refresh license/quota status in the status bar."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "esbuild src/extension.ts --bundle --platform=node --target=node18 --external:vscode --outfile=dist/extension.js",
    "build:min": "npm run build -- --minify",
    "watch": "npm run build -- --sourcemap --watch",
    "typecheck": "tsc --noEmit",
    "test": "esbuild src/settings.ts --bundle --format=esm --platform=node --outfile=dist/settings.mjs && node --test test/settings.test.mjs",
    "package": "vsce package --no-dependencies",
    "publish": "vsce publish --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.21.5",
    "typescript": "^5.4.5"
  }
}
